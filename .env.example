# single: one multi-model routing listener; each request uses that model's own plane
# split: one management/WebUI listener plus isolated Pro, Flash and Vision data listeners
# all: split listeners plus one multi-model routing listener (not a shared logic plane)
GATEWAY_INSTANCE_MODE=split

# Listener-only settings. Per-model Key / upstream / mode come from GATEWAY_PRO_*,
# GATEWAY_FLASH_* and GATEWAY_VISION_*. An empty model Key is not filled from
# GATEWAY_UPSTREAM_API_KEY; that model returns 503. An empty model upstream uses
# https://api.deepseek.com.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8642
GATEWAY_UPSTREAM_BASE_URL=https://api.deepseek.com
# Unused by multi-model routing. Each model has its own GATEWAY_*_ENHANCEMENT_MODE.
GATEWAY_ENHANCEMENT_MODE=bypass
GATEWAY_MODELS=deepseek-v4-pro,deepseek-v4-flash,deepseek-v4-flash-vision-exp
GATEWAY_PRO_ANCHOR_PATH=anchors/dsh-minimal-open-workstream-pro.json

# Not a shared credential. Multi-model listeners do not copy this onto Pro/Flash/Vision.
# Incoming Harness Authorization and x-api-key headers are always discarded.
GATEWAY_UPSTREAM_API_KEY=
# Required when GATEWAY_HOST is not loopback. Used only by the /__gateway
# diagnostics API and local WebUI; the browser keeps it in sessionStorage.
GATEWAY_MANAGEMENT_TOKEN=

# Split-instance settings. Set GATEWAY_INSTANCE_MODE=split to activate.
# The WebUI/diagnostics listener never forwards model requests.
GATEWAY_WEB_UI_HOST=127.0.0.1
GATEWAY_WEB_UI_PORT=8642
# Used only in all mode. The 8646 listener routes by request model like single.
GATEWAY_COMBINED_HOST=127.0.0.1
GATEWAY_COMBINED_PORT=8646
# Unused by combined routing; each model plane keeps its own enhancement mode.
GATEWAY_COMBINED_ENHANCEMENT_MODE=bypass
GATEWAY_COMBINED_LOG_DIR=
GATEWAY_PRO_ENABLED=true
GATEWAY_PRO_HOST=127.0.0.1
GATEWAY_PRO_PORT=8643
GATEWAY_PRO_UPSTREAM_API_KEY=
GATEWAY_PRO_UPSTREAM_BASE_URL=
GATEWAY_PRO_ENHANCEMENT_MODE=
GATEWAY_PRO_LOG_DIR=
GATEWAY_FLASH_ENABLED=true
GATEWAY_FLASH_HOST=127.0.0.1
GATEWAY_FLASH_PORT=8644
GATEWAY_FLASH_UPSTREAM_API_KEY=
GATEWAY_FLASH_UPSTREAM_BASE_URL=
# Flash defaults to bypass until a Flash-native Anchor is generated.
GATEWAY_FLASH_ENHANCEMENT_MODE=
GATEWAY_FLASH_ANCHOR_PATH=
GATEWAY_FLASH_LOG_DIR=
GATEWAY_VISION_ENABLED=true
GATEWAY_VISION_HOST=127.0.0.1
GATEWAY_VISION_PORT=8645
GATEWAY_VISION_UPSTREAM_API_KEY=
GATEWAY_VISION_UPSTREAM_BASE_URL=
# Vision has no bundled model-native Anchor, so its default mode is bypass.
GATEWAY_VISION_ENHANCEMENT_MODE=
GATEWAY_VISION_ANCHOR_PATH=
GATEWAY_VISION_LOG_DIR=

# off | metadata | full. Metadata still contains thought-chain counts and usage.
# Full additionally stores prompts, reasoning and tool results; use it only for
# local debugging because those values can contain source code and user data.
GATEWAY_CAPTURE_MODE=metadata
GATEWAY_CAPTURE_LIMIT_BYTES=16777216
GATEWAY_RESPONSE_OBSERVATION_LIMIT_BYTES=67108864
GATEWAY_UPSTREAM_TIMEOUT_MS=900000
GATEWAY_REQUEST_LIMIT_BYTES=33554432
GATEWAY_DIAGNOSTIC_HISTORY_LIMIT=100
GATEWAY_LOG_MAX_BYTES=67108864
GATEWAY_LOG_MAX_FILES=5
